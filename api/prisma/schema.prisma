generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All money is stored as integer cents (USD).

enum Role {
  CUSTOMER
  ADMIN
}

enum Tier {
  MEMBER
  INSIDER
  VIP
  FOUNDER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ProductForm {
  VIAL
  MIST
  SUPPLY
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderKind {
  STANDARD
  BOX
  WHOLESALE
  MEMBERSHIP
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

enum PayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  passwordHash       String
  name               String
  phone              String?
  role               Role            @default(CUSTOMER)
  tier               Tier            @default(MEMBER)
  tierExpiresAt      DateTime?
  pointsBalance      Int             @default(0)
  createdAt          DateTime        @default(now())
  lastLoginAt        DateTime?
  // Set on the bootstrap admin so the one-time password must be replaced at first sign-in.
  mustChangePassword Boolean         @default(false)
  /// Bumped on password change/reset: every session issued before it stops working.
  sessionVersion     Int             @default(0)
  orders             Order[]
  passwordResets     PasswordReset[]
  appGrants          AppGrant[]
  appCodes           AppCode[]
  affiliate          Affiliate?
  pointsTxns         PointsTxn[]
  subscriptions      Subscription[]
  /// Soft delete: set when archived in the admin (restorable from Admin > Archive).
  deletedAt          DateTime?
  deletedBy          String?
}

/// A connected first-party app (e.g. the dose tracker) the user signed in to with their KYVO account.
model AppGrant {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@unique([userId, clientId])
}

/// One-time "Sign in with KYVO" authorization codes (OAuth 2 code flow with PKCE). Stored hashed, 2 minutes.
model AppCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

/// "Forgot password" links. Only a SHA-256 of the token is stored; each link works once, for 1 hour.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  tagline          String        @default("")
  description      String        @default("")
  image            String?
  gallery          String[]      @default([])
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  form             ProductForm   @default(VIAL)
  status           ProductStatus @default(ACTIVE)
  featured         Boolean       @default(false)
  boxEligible      Boolean       @default(true)
  purity           Decimal?      @db.Decimal(5, 2)
  casNumber        String?
  molecularFormula String?
  molecularWeight  String?
  sequence         String?
  storage          String?
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  variants         Variant[]
  coas             Coa[]
  orderItems       OrderItem[]
  /// Soft delete: set when archived in the admin (restorable from Admin > Archive).
  deletedAt        DateTime?
  deletedBy        String?

  @@index([status, sortOrder])
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  sku        String      @unique
  priceCents Int
  costCents  Int         @default(0)
  stock      Int         @default(0)
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]
}

model Coa {
  id             String    @id @default(cuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotNumber      String
  /// Name of the compound on the certificate (a blend product can carry one certificate per compound).
  documentTitle  String?
  mfgDate        DateTime?
  retestDate     DateTime?
  variantLabel   String?
  purity         Decimal   @db.Decimal(5, 2)
  labeledAmount  String?
  measuredAmount String?
  identity       String    @default("Confirmed (LC-MS)")
  endotoxin      String    @default("Pass")
  microbial      String    @default("Pass")
  heavyMetals    String    @default("Pass")
  appearance     String    @default("White lyophilized powder")
  lab            String    @default("Independent ISO/IEC 17025 lab")
  assays         Int       @default(6)
  testedAt       DateTime
  /// Legacy original-file link. Never sent to shoppers.
  fileUrl        String?
  /// View-only certificate pages: image base paths, rendered at `${base}-{900|1700}.{avif,webp}`.
  pages          String[]  @default([])
  createdAt      DateTime  @default(now())
  /// Soft delete: set when archived in the admin (restorable from Admin > Archive).
  deletedAt      DateTime?
  deletedBy      String?

  @@unique([productId, lotNumber])
}

model Order {
  id                  String        @id @default(cuid())
  number              String        @unique
  accessKey           String        @unique
  kind                OrderKind     @default(STANDARD)
  status              OrderStatus   @default(PENDING_PAYMENT)
  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email               String
  name                String
  phone               String?
  shippingAddress     Json
  paymentMethod       String
  paymentRef          String?
  billCode            String?
  paymentUrl          String?
  paymentStatusNote   String?
  subtotalCents       Int
  tierDiscountCents   Int           @default(0)
  couponDiscountCents Int           @default(0)
  pointsDiscountCents Int           @default(0)
  shippingCents       Int           @default(0)
  taxCents            Int           @default(0)
  totalCents          Int
  costCents           Int           @default(0)
  couponCode          String?
  /// True when this order consumed one use of a store coupon (released again on cancel/refund).
  couponCounted       Boolean       @default(false)
  affiliateId         String?
  affiliate           Affiliate?    @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  pointsRedeemed      Int           @default(0)
  pointsEarned        Int           @default(0)
  carrier             String?
  trackingNumber      String?
  customerNote        String?
  adminNote           String?
  meta                Json?
  subscriptionId      String?
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  paidAt              DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  refundedAt          DateTime?
  items               OrderItem[]
  events              OrderEvent[]
  commission          Commission?
  bills               PaymentBill[]
  /// Soft delete: set when archived in the admin (restorable from Admin > Archive).
  deletedAt           DateTime?
  deletedBy           String?

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email])
  @@index([deletedAt])
}

/// Every ToyyibPay bill issued for an order. A shopper can pay any of them (old tab, resent
/// link), so payment checks look at all of them, each against the gateway it was created on.
model PaymentBill {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  billCode    String    @unique
  /// "sandbox" or "production": which ToyyibPay the bill lives on.
  env         String
  amountCents Int
  paymentUrl  String
  expiresAt   DateTime?
  /// Set once the bill can no longer be paid: deactivated at ToyyibPay, or it is the bill that paid.
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name           String
  variantLabel   String
  image          String?
  quantity       Int
  unitPriceCents Int
  discountPct    Int      @default(0)
  lineTotalCents Int
  unitCostCents  Int      @default(0)
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String
  actor     String?
  createdAt DateTime @default(now())
}

model Coupon {
  id                 String     @id @default(cuid())
  code               String     @unique
  type               CouponType @default(PERCENT)
  value              Int
  minSubtotal        Int        @default(0)
  /// Cap on the discount a PERCENT code can give (cents). Null = no cap.
  maxDiscountCents   Int?
  /// Total redemptions across all customers. Null = unlimited.
  maxUses            Int?
  /// Redemptions per customer (matched by account or email). Null = unlimited.
  maxUsesPerCustomer Int?
  uses               Int        @default(0)
  startsAt           DateTime?
  expiresAt          DateTime?
  active             Boolean    @default(true)
  /// Only for customers with no previous paid or open order.
  firstOrderOnly     Boolean    @default(false)
  /// When false the code only discounts items that did not already get a quantity-tier discount.
  stackWithTiers     Boolean    @default(true)
  /// Order types the code works on: standard, wholesale, box.
  modes              String[]   @default(["standard"])
  /// Limit to these products / categories. Empty = whole order.
  productIds         String[]   @default([])
  categoryIds        String[]   @default([])
  description        String?
  createdAt          DateTime   @default(now())
  /// Soft delete: set when archived in the admin (restorable from Admin > Archive).
  deletedAt          DateTime?
  deletedBy          String?
}

model Affiliate {
  id                String           @id @default(cuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  code              String           @unique
  couponCode        String           @unique
  status            AffiliateStatus  @default(PENDING)
  commissionRate    Int              @default(20)
  platform          String
  handle            String
  otherHandles      String?
  website           String?
  paymentEmail      String?
  // Payouts are manual bank transfers; these details are what the admin pays into.
  payoutMethod      String           @default("BANK")
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  promotionPlan     String?
  adminNote         String?
  createdAt         DateTime         @default(now())
  approvedAt        DateTime?
  clicks            AffiliateClick[]
  commissions       Commission[]
  payouts           Payout[]
  orders            Order[]
}

model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  landing     String?
  referrer    String?
  visitorHash String?
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
}

model Commission {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  orderId     String           @unique
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  baseCents   Int
  rate        Int
  amountCents Int
  status      CommissionStatus @default(PENDING)
  payoutId    String?
  payout      Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  approvedAt  DateTime?

  @@index([affiliateId, status])
}

model Payout {
  id          String       @id @default(cuid())
  affiliateId String
  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amountCents Int
  method      String
  destination String?
  reference   String?
  status      PayoutStatus @default(REQUESTED)
  note        String?
  createdAt   DateTime     @default(now())
  paidAt      DateTime?
  commissions Commission[]
}

model PointsTxn {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  orderId   String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String?
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  name            String
  shippingAddress Json
  items           Json
  priceCents      Int
  status          SubscriptionStatus @default(ACTIVE)
  commitMonths    Int                @default(3)
  boxesShipped    Int                @default(0)
  nextShipAt      DateTime
  createdAt       DateTime           @default(now())
  cancelledAt     DateTime?
  orders          Order[]
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  topic     String    @default("General")
  orderRef  String?
  message   String
  handled   Boolean   @default(false)
  createdAt DateTime  @default(now())
  /// Soft delete: set when archived in the admin (restorable from Admin > Archive).
  deletedAt DateTime?
  deletedBy String?
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value Json
}
