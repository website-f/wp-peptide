# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-64-random-hex-chars
COOKIE_SECURE=false

# Public URL shoppers use (ToyyibPay return URL) and the URL ToyyibPay calls back.
PUBLIC_URL=http://localhost:8600
API_PUBLIC_URL=http://localhost:8600

# Encrypts payment-gateway keys saved in the database. Generate with: openssl rand -hex 32
# Back it up with this file; if it is lost or changed, re-enter the ToyyibPay keys in the admin.
DATA_ENCRYPTION_KEY=

# ToyyibPay keys and sandbox/production mode are set in Admin > Settings > ToyyibPay (encrypted), not here.

# Transactional email (order, payment, shipping, partner notices). Leave SMTP_HOST empty to log instead of send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KYVO Labs <support@kyvolabs.com>

# 1 = also create sample customers/orders/partners (local demo only, never on the VPS)
SEED_DEMO=0
KYVO_PORT=8600
KYVO_DB_PORT=8602

# Licensed add-on. Membership tiers are hidden from shoppers AND admins unless true.
ENABLE_MEMBERSHIP=false
