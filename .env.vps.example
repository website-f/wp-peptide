COMPOSE_PROJECT_NAME=kyvo
KYVO_DOMAIN=kyvo.example.com
KYVO_PORT=8600

POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECURE=true
PUBLIC_URL=https://kyvo.example.com
API_PUBLIC_URL=https://kyvo.example.com
# Encrypts payment-gateway keys saved in the database. deploy-vps.sh generates it if missing.
# Back it up with this file; if it is lost or changed, re-enter the ToyyibPay keys in the admin.
DATA_ENCRYPTION_KEY=

# ToyyibPay keys and sandbox/production mode: Admin > Settings > ToyyibPay (encrypted). Not in .env.
# Transactional email (order, payment, shipping, partner notices). Leave SMTP_HOST empty to log instead of send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KYVO Labs <support@kyvolabs.com>

SEED_DEMO=0

# Licensed add-on. Membership tiers are hidden from shoppers AND admins unless true.
ENABLE_MEMBERSHIP=false
