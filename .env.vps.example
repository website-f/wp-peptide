COMPOSE_PROJECT_NAME=kyvo
KYVO_DOMAIN=kyvo.example.com
KYVO_PORT=8600

POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECURE=true
PUBLIC_URL=https://kyvo.example.com
API_PUBLIC_URL=https://kyvo.example.com

# Switch to https://toyyibpay.com with the live key + category when going live.
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com
