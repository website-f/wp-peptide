# docker-mailserver settings (no secrets here). Reference:
# https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

TZ=Asia/Kuala_Lumpur
LOG_LEVEL=info
ONE_DIR=1
ACCOUNT_PROVISIONER=FILE
# Accounts, forwarders and quotas are edited by the /mail panel; changes apply within seconds.
DMS_CONFIG_POLL=2

# This VPS has no working IPv6 route, and its IPv4 address is the one with reverse DNS and SPF.
POSTFIX_INET_PROTOCOLS=ipv4
DOVECOT_INET_PROTOCOLS=ipv4

# Spam filtering and DKIM signing: Rspamd only (lighter than Amavis + SpamAssassin + ClamAV).
ENABLE_RSPAMD=1
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
RSPAMD_LEARN=1
RSPAMD_GREYLISTING=0
RSPAMD_CHECK_AUTHENTICATED=0
RSPAMD_HFILTER=1
MOVE_SPAM_TO_JUNK=1
SPAM_SUBJECT=

ENABLE_FAIL2BAN=1
FAIL2BAN_BLOCKTYPE=drop
ENABLE_QUOTAS=1
# Logged-in users may only send as their own address (or a forwarder they own).
SPOOF_PROTECTION=1
PERMIT_DOCKER=none
ENABLE_POP3=0
ENABLE_IMAP=1
ENABLE_MANAGESIEVE=0
ENABLE_SRS=0
# 25 MB messages, like most hosts.
POSTFIX_MESSAGE_SIZE_LIMIT=26214400
POSTFIX_MAILBOX_SIZE_LIMIT=0
LOGROTATE_INTERVAL=weekly
LOGROTATE_COUNT=8
