# Copy to mail/.env (deploy-mail.sh creates it on the VPS).
MAIL_DOMAIN=kyvomethod.com
MAIL_HOSTNAME=mail.kyvomethod.com
SERVER_IP=5.189.156.178
DKIM_SELECTOR=mail
# Let's Encrypt files for MAIL_HOSTNAME, issued by orxies (certmagic layout: <host>.crt / <host>.key).
CERT_DIR=/opt/orxies/certs/certificates/acme-v02.api.letsencrypt.org-directory/mail.kyvomethod.com
# 24 random characters; encrypts webmail session data.
ROUNDCUBE_DES_KEY=
COOKIE_SECURE=true
MAIL_TLS_MODE=verify
